{
  "name": "@fullscroll/core",
  "version": "1.3.0",
  "description": "Publisher-friendly full-page scrolling powered by an external Swiper runtime.",
  "private": true,
  "type": "module",
  "main": "./dist/fullscroll.js",
  "module": "./dist/fullscroll.esm.js",
  "types": "./dist/fullscroll.d.ts",
  "style": "./dist/fullscroll.css",
  "exports": {
    ".": {
      "types": "./dist/fullscroll.d.ts",
      "import": "./dist/fullscroll.esm.js",
      "default": "./dist/fullscroll.esm.js"
    },
    "./gsap": {
      "types": "./dist/gsap.d.ts",
      "import": "./dist/gsap.esm.js",
      "default": "./dist/gsap.esm.js"
    },
    "./style.css": "./dist/fullscroll.css"
  },
  "files": [
    "dist",
    "README.md",
    "FEATURES.md",
    "ROADMAP.md",
    "AI_GUIDE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-mobile-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:types": "tsc -p tsconfig.types.json",
    "check:dist": "node scripts/check-build.mjs",
    "check": "node scripts/check-source.mjs && vitest run && npm run build && npm run check:types && npm run check:dist",
    "test:browser": "playwright test"
  },
  "peerDependencies": {
    "swiper": ">=14.0.0 <15.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.25.0",
    "gsap": "^3.15.0",
    "jsdom": "^26.0.0",
    "swiper": "^14.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m0n9x3/fullscroll.git"
  },
  "homepage": "https://github.com/m0n9x3/fullscroll#readme",
  "bugs": {
    "url": "https://github.com/m0n9x3/fullscroll/issues"
  },
  "keywords": [
    "fullpage",
    "scroll",
    "swiper",
    "vanilla-javascript",
    "horizontal-scroll",
    "snap-scroll"
  ],
  "license": "MIT"
}
